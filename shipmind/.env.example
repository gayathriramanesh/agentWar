# ── Google AI Studio (https://aistudio.google.com/apikey) ─────────────────────
# Copy to .env (never commit .env). With no key, ShipMind runs in MOCK mode automatically.
# Adding a key switches only the agents' reasoning to Gemini; warehouses and carriers stay mock data.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-ai-studio-key-here

# ── Model tiers (check model IDs in AI Studio; override if one isn't available) ─
SHIPMIND_FAST_MODEL=gemini-2.5-flash
SHIPMIND_BALANCED_MODEL=gemini-3.5-flash
SHIPMIND_DEEP_MODEL=gemini-3.1-pro-preview
# Any tier accepts a LiteLLM id (e.g. openai/gpt-4o-mini; needs `pip install litellm` + that vendor's key).

# ── Runtime ───────────────────────────────────────────────────────────────────
SHIPMIND_MOCK_LLM=auto            # auto | true | false
SHIPMIND_USE_MCP=true             # false = in-process tools (fallback if MCP misbehaves)
SHIPMIND_MAX_HEAL_ITERATIONS=3
SHIPMIND_CHAOS_RATE=0             # 0.3 = 30% of carrier/model API calls fail (demo self-healing)
SHIPMIND_CHAOS_SEED=42
SHIPMIND_MOCK_LATENCY_MS=40       # simulated carrier API latency

# ── Guardrails / anomaly detection ────────────────────────────────────────────
SHIPMIND_MAX_UNITS_PER_ORDER=500  # larger quantities are rejected as anomalies
SHIPMIND_MAX_INPUT_CHARS=2000
SHIPMIND_GUARDRAIL_FAIL_OPEN=false  # guardrail model down -> reject (fail closed)

# ── Execution optimisation ────────────────────────────────────────────────────
SHIPMIND_FASTPATH_MAX_COMPLEXITY=medium  # none|low|medium|high: rules engine plans these with 0 LLM calls
SHIPMIND_FAST_ROUTE=true                 # obvious new orders skip the concierge LLM call
SHIPMIND_QUOTE_CACHE_TTL_S=30            # reuse carrier rate quotes (0 = off)
SHIPMIND_AUCTION_TIMEOUT_MS=3000         # slow carriers are dropped from the auction
SHIPMIND_LLM_TIMEOUT_S=30                # per model call

# ── Token economics ───────────────────────────────────────────────────────────
SHIPMIND_TOKEN_BUDGET_PER_ORDER=60000    # hard ceiling; past it model calls are refused and the order escalates
SHIPMIND_BUDGET_DOWNGRADE_AT=0.6         # past 60% of budget the planner drops the deep model
# USD per 1M tokens [input, output] per tier. Defaults are illustrative: set your real prices.
# SHIPMIND_MODEL_PRICES={"fast": [0.3, 2.5], "balanced": [0.5, 3.0], "deep": [2.0, 12.0]}
