# ── Google AI Studio (https://aistudio.google.com/apikey) ─────────────────────
# Copy to .env (never commit .env). With no key, ShipMind runs in MOCK mode automatically.
# Adding a key switches only the agents' reasoning to Gemini; warehouses and carriers stay mock data.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-ai-studio-key-here

# ── Model tiers (check model IDs in AI Studio; override if one isn't available) ─
SHIPMIND_FAST_MODEL=gemini-2.5-flash
SHIPMIND_BALANCED_MODEL=gemini-3.5-flash
SHIPMIND_DEEP_MODEL=gemini-3.1-pro-preview
# Cross-vendor second opinion (optional, needs `pip install litellm` + that vendor's key):
# SHIPMIND_VALIDATOR_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
SHIPMIND_VALIDATOR_MODEL=gemini-3.5-flash

# ── Runtime ───────────────────────────────────────────────────────────────────
SHIPMIND_MOCK_LLM=auto            # auto | true | false
SHIPMIND_USE_MCP=true             # false = in-process tools (fallback if MCP misbehaves)
SHIPMIND_MAX_HEAL_ITERATIONS=3
SHIPMIND_CHAOS_RATE=0             # 0.3 = 30% of carrier/model API calls fail (demo self-healing)
SHIPMIND_CHAOS_SEED=42
SHIPMIND_MOCK_LATENCY_MS=40       # simulated carrier API latency
